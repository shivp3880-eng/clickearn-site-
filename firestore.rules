rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.email == "admin@example.com"; } // <- apna admin email
    function isMe(id) { return request.auth != null && request.auth.uid == id; }

    match /users/{id} {
      allow read: if isMe(id) || isAdmin();
      allow create: if isMe(id) && request.resource.data.points == 0;
      allow update: if isAdmin() || (isMe(id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','todayPoints','todayDate','tasks','lastCheckin','spinDate','spinCount','quizDate','earned'])
        && request.resource.data.points - resource.data.points <= 100
        && request.resource.data.get('spinCount', 0) <= 2
        && (request.resource.data.get('lastCheckin', 0) == resource.data.get('lastCheckin', 0)
            || request.resource.data.get('lastCheckin', 0) - resource.data.get('lastCheckin', 0) >= 86000000));
    }
    match /leaderboard/{id} {
      allow read: if request.auth != null;
      allow write: if isMe(id) && request.resource.data.keys().hasOnly(['name','earned']);
    }
    match /withdrawals/{id} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == "Pending" && request.resource.data.amount >= 150;
      allow update: if isAdmin();
    }
    match /payouts/{id} { allow read: if true; allow write: if isAdmin(); }
    match /stats/{id}   { allow read: if true; allow write: if request.auth != null; }
  }
}
